# Data calls use same-origin /api/* on Next.js and are proxied to the backend
# server-side (see src/app/api/[...path]/route.ts). These values are server-side
# only — keep localhost in dev; no LAN IP is injected into the client bundle.
BACKEND_URL=http://localhost:3000
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3001

# Optional: extra hosts allowed to open the dev server (phone testing on your
# LAN). Put your machine's LAN IP in your local .env, never commit it here.
# ALLOWED_DEV_ORIGINS=192.168.1.42
