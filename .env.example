# Where the backend answers. Read on the server only: the browser talks to this
# app's same-origin /api/* proxy (src/app/api/[...path]/route.ts), and server
# components call the backend directly (src/lib/api-transport.server.ts). No
# backend address reaches the client bundle. Required in production — there is
# no fallback outside development.
BACKEND_URL=http://localhost:3000
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3001

# Deployment requirement — the reader's address (X-Forwarded-For).
# The backend rate-limits per client address, and this app forwards
# X-Forwarded-For as it received it. Next fills that header from the socket
# only when it is absent and keeps a client's own value otherwise, so this app
# must not be reachable directly: put a reverse proxy in front that OVERWRITES
# the header with the real client address (nginx:
# `proxy_set_header X-Forwarded-For $remote_addr;`, Caddy does it by default),
# or a platform that does the same (Vercel). On the backend, list that proxy and
# this app's own address in TRUST_PROXY_IPS.

# Optional: extra hosts allowed to open the dev server (phone testing on your
# LAN). Put your machine's LAN IP in your local .env, never commit it here.
# ALLOWED_DEV_ORIGINS=192.168.1.42
